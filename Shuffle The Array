class Solution {
    public int[] shuffle(int[] nums, int n) {
        int[] ans = new int[nums.length];
              int j = 0;
              int k = 0;  
        for (int i = 0; i < nums.length; i += 2) {
            ans[i] = nums[j];
            j++;
        }

        for (int i = 1; i < nums.length; i += 2) {
            ans[i] = nums[k + n];
            k++;
        }

    return ans;

    }
}
