class Solution {
    public List<List<Integer>> threeSum(int[] nums) {
        List<List<Integer>> result = new ArrayList<>();
        int n = nums.length;
        int d = 0;
        Arrays.sort(nums);
        for (int i = 0; i < n - 2; i++) {
            if (i > 0 && nums[i] == nums[i - 1]) {
                continue;
            }
            int k = n - 1;
            int j = i + 1;
            d = nums[i];
        while(j < k) {
            if (d + nums[j] + nums[k] < 0) {
                j++;
            }else if (d + nums[j] + nums[k] > 0) {
                k--;
            }else {
                result.add(Arrays.asList(d, nums[j], nums[k]));
                
                while(j < k && nums[j] == nums[j + 1]) {
                    j++;
                }
                while(j < k && nums[k] == nums[k - 1]) {
                    k--;
                }
                
                j++;
                k--;
            }
        }
        }    
        return result;
    }
}
