class Solution {
    public int countSegments(String s) {
        String trimmed = s.trim();
        trimmed = trimmed.replaceAll("\\s+", " ");
        int count = 0;
        if (trimmed.length() == 0) {
            return 0;
        }

        for (int i = 0; i < trimmed.length(); i++) {
            if (trimmed.charAt(i) == ' ') {
                count++;
            }
        }
    return count + 1;    
    }

}
